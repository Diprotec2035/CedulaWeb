							<img src="/assets/images/brand/logo1.png" class="desktop-logo theme-logo" alt="viboonlogo" />
						</a>
					</div>

					<div class="main-header-right ms-auto">
						<button class="navbar-toggler navresponsive-toggler d-lg-none ms-auto collapsed"
                                type="button"
							    data-bs-toggle="collapse"
                                data-bs-target="#navbarSupportedContent-4"
							    aria-controls="navbarSupportedContent-4"
                                aria-expanded="false"
                                aria-label="Toggle navigation">
							<span class="navbar-toggler-icon fe fe-more-vertical"></span>
						</button>

						<div class="navbar navbar-expand-lg navbar-collapse responsive-navbar p-0">
							<div class="collapse navbar-collapse" id="navbarSupportedContent-4">
								<ul class="nav nav-item header-icons navbar-nav-right ms-auto">

									<li class="nav-item d-none d-md-flex align-items-center me-3">
										<span class="tx-13 text-muted me-1">
											<i class="fe fe-briefcase me-1"></i>Empresa:
										</span>
										<span class="tx-13 fw-semibold text-dark">
											<asp:Label ID="lblEmpresaNombre" runat="server"></asp:Label>
										</span>
									</li>

									<li id="liTokenApiCabecera" runat="server" visible="false" class="nav-item d-none d-md-flex align-items-center me-3">
										<span id="spnTokenApiCabecera" runat="server" class="badge bg-success-transparent text-success tx-12 fw-semibold">
											<i class="fe fe-shield me-1"></i>
											<asp:Label ID="lblTokenApiCabecera" runat="server"></asp:Label>
										</span>
