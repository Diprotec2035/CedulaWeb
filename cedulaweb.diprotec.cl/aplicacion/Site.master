    <script src="/assets/plugins/bootstrap/popper.min.js"></script>
    <script src="/assets/plugins/bootstrap/js/bootstrap.min.js"></script>
    <script src="/assets/plugins/perfect-scrollbar/perfect-scrollbar.min.js"></script>
    <script src="/assets/plugins/sidemenu/sidemenu.js"></script>
	<script src="/assets/plugins/date-picker/jquery-ui.js"></script>
    <script src="/assets/plugins/sidebar/sidebar.js"></script>
    <script src="/assets/js/sticky.js"></script>
    <script src="/assets/js/custom-switcher.js"></script>
    <script src="/assets/js/custom.js"></script>
    <script src="/assets/switcher/js/switcher.js"></script>

	<script type="text/javascript">
        var sesionExpiraMs = Number(window.sesionExpiraServidorMs || <%=GetSesionExpiraUnixMilliseconds()%>);
        var sesionRenovadaMs = Number(window.sesionRenovadaServidorMs || <%=GetSesionRenovadaUnixMilliseconds()%>);
		var claveSesionCompartida = "<%=HttpUtility.JavaScriptStringEncode(GetSesionSincronizacionClave())%>";
		var urlInicioSesion = "<%=HttpUtility.JavaScriptStringEncode(ConstantesModelo.ConsHttpInicio)%>";
        var intervaloSesion = null;
        var temporizadorRedireccionSesion = null;
        var toleranciaRedireccionSesionMs = 2000;

        $(window).on("load", function () {
            $("#global-loader").hide();
            inicializarSesionCompartida();
            iniciarRelojSesion();
        });

        $(document).on("click", ".slide-item", function () {
            $("#global-loader").show();
        });

        var intervaloCerrarSesion = null;
        var segundosCerrarSesion = 10;

        $(document).on("shown.bs.modal", "#modalCerrarSesion", function () {
            segundosCerrarSesion = 10;
            $("#contadorCerrarSesion").text(segundosCerrarSesion);

            intervaloCerrarSesion = setInterval(function () {
                segundosCerrarSesion--;

                $("#contadorCerrarSesion").text(segundosCerrarSesion);

                if (segundosCerrarSesion <= 0) {
                    clearInterval(intervaloCerrarSesion);
                    intervaloCerrarSesion = null;

                    var modalElemento = document.getElementById("modalCerrarSesion");
                    var modal = bootstrap.Modal.getInstance(modalElemento);

                    if (modal) {
                        modal.hide();
                    }
                }
            }, 1000);
        });

        $(document).on("hidden.bs.modal", "#modalCerrarSesion", function () {
            if (intervaloCerrarSesion !== null) {
                clearInterval(intervaloCerrarSesion);
                intervaloCerrarSesion = null;
            }

            segundosCerrarSesion = 10;
            $("#contadorCerrarSesion").text(segundosCerrarSesion);
        });

        function obtenerEstadoSesionCompartida() {
            if (!claveSesionCompartida) {
                return null;
            }

            try {
                var valor = window.localStorage.getItem(claveSesionCompartida);

                if (!valor) {
                    return null;
                }

                var estado = JSON.parse(valor);
                var expiraMs = Number(estado.expiraMs);
                var renovadaMs = Number(estado.renovadaMs);

                if (!isFinite(expiraMs) || expiraMs <= 0 || !isFinite(renovadaMs) || renovadaMs <= 0) {
                    return null;
                }

                return {
                    expiraMs: expiraMs,
                    renovadaMs: renovadaMs
                };
            }
            catch (error) {
                return null;
            }
        }

        function guardarEstadoSesionCompartida() {
            if (!claveSesionCompartida || !sesionExpiraMs || !sesionRenovadaMs) {
                return;
            }

            try {
                window.localStorage.setItem(claveSesionCompartida, JSON.stringify({
                    expiraMs: sesionExpiraMs,
                    renovadaMs: sesionRenovadaMs
                }));
            }
            catch (error) {
            }
        }

        function aplicarEstadoSesion(expiraMs, renovadaMs, compartir) {
            expiraMs = Number(expiraMs);
            renovadaMs = Number(renovadaMs);

            if (!isFinite(expiraMs) || expiraMs <= 0 || !isFinite(renovadaMs) || renovadaMs <= 0) {
                return false;
            }

            if (renovadaMs < sesionRenovadaMs) {
                return false;
            }

            if (renovadaMs === sesionRenovadaMs && expiraMs <= sesionExpiraMs) {
                return false;
            }

            sesionExpiraMs = expiraMs;
            sesionRenovadaMs = renovadaMs;

            window.sesionExpiraServidorMs = expiraMs;
            window.sesionRenovadaServidorMs = renovadaMs;

            cancelarRedireccionSesion();

            if (compartir) {
                guardarEstadoSesionCompartida();
            }

            return true;
        }

        function inicializarSesionCompartida() {
            var estadoCompartido = obtenerEstadoSesionCompartida();

            if (estadoCompartido !== null) {
                aplicarEstadoSesion(estadoCompartido.expiraMs, estadoCompartido.renovadaMs, false);
            }

            guardarEstadoSesionCompartida();
        }

        function sincronizarSesionCompartida() {
            var estadoCompartido = obtenerEstadoSesionCompartida();

            if (estadoCompartido === null) {
                return false;
            }

            return aplicarEstadoSesion(estadoCompartido.expiraMs, estadoCompartido.renovadaMs, false);
        }

        function actualizarExpiracionSesion(expiraMs, renovadaMs) {
            if (aplicarEstadoSesion(expiraMs, renovadaMs, true)) {
                mostrarTiempoSesion();
            }
        }

        window.actualizarExpiracionSesion = actualizarExpiracionSesion;

        function obtenerSegundosRestantesSesion() {
            sincronizarSesionCompartida();

            if (!sesionExpiraMs || sesionExpiraMs <= 0) {
                return 0;
            }

            var milisegundosRestantes = sesionExpiraMs - new Date().getTime();
            var segundosRestantes = Math.ceil(milisegundosRestantes / 1000);

            return segundosRestantes > 0 ? segundosRestantes : 0;
        }

        function mostrarTiempoSesion() {
            var segundosRestantes = obtenerSegundosRestantesSesion();

            if (segundosRestantes <= 0) {
                $("#lblSesion").text("00:00:00");
                programarRedireccionPorSesionExpirada();
                return;
            }

            cancelarRedireccionSesion();

            var horas = Math.floor(segundosRestantes / 3600);
            var minutos = Math.floor((segundosRestantes % 3600) / 60);
            var segundos = segundosRestantes % 60;

            horas = horas < 10 ? "0" + horas : horas;
            minutos = minutos < 10 ? "0" + minutos : minutos;
            segundos = segundos < 10 ? "0" + segundos : segundos;

            $("#lblSesion").text(horas + ":" + minutos + ":" + segundos);
        }

        function iniciarRelojSesion() {
            mostrarTiempoSesion();

            if (intervaloSesion !== null) {
                clearInterval(intervaloSesion);
                intervaloSesion = null;
            }

            intervaloSesion = setInterval(function () {
                mostrarTiempoSesion();
            }, 1000);
        }

        function cancelarRedireccionSesion() {
            if (temporizadorRedireccionSesion !== null) {
                clearTimeout(temporizadorRedireccionSesion);
                temporizadorRedireccionSesion = null;
            }
        }

        function programarRedireccionPorSesionExpirada() {
            if (temporizadorRedireccionSesion !== null) {
                return;
            }

            temporizadorRedireccionSesion = setTimeout(function () {
                temporizadorRedireccionSesion = null;
                sincronizarSesionCompartida();

                if (obtenerSegundosRestantesSesion() > 0) {
                    mostrarTiempoSesion();
                    return;
                }

                redirigirPorSesionExpirada();
            }, toleranciaRedireccionSesionMs);
        }

        function redirigirPorSesionExpirada() {
            if (intervaloSesion !== null) {
                clearInterval(intervaloSesion);
                intervaloSesion = null;
            }

            cancelarRedireccionSesion();
            window.location.replace(urlInicioSesion);
        }

        window.addEventListener("storage", function (event) {
            if (event.key !== claveSesionCompartida || !event.newValue) {
                return;
            }

            try {
                var estado = JSON.parse(event.newValue);

                if (aplicarEstadoSesion(estado.expiraMs, estado.renovadaMs, false)) {
                    mostrarTiempoSesion();
                }
            }
            catch (error) {
            }
        });

        document.addEventListener("visibilitychange", function () {
            if (!document.hidden) {
                mostrarTiempoSesion();
            }
        });

        window.addEventListener("focus", function () {
            mostrarTiempoSesion();
        });

        window.addEventListener("pageshow", function () {
            mostrarTiempoSesion();
        });

        if (typeof Sys !== "undefined" && Sys.WebForms && Sys.WebForms.PageRequestManager) {
            Sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () {
                actualizarExpiracionSesion(window.sesionExpiraServidorMs, window.sesionRenovadaServidorMs);
            });
        }
    </script>
</body>
</html>
