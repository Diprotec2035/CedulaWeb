<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="cedulaweb.diprotec.cl.aplicacion.Site" %>
<%@ Import Namespace="Modelo" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="es" translate="no">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title><%=ConstantesModelo.ConsTituloWebPage%></title>

    <link id="style" href="/assets/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/assets/css/style.css" rel="stylesheet" />
    <link href="/assets/css/plugins.css" rel="stylesheet" />
    <link href="/assets/css/icons.css" rel="stylesheet" />
    <link href="/assets/switcher/css/switcher.css" rel="stylesheet" />
    <link href="/assets/switcher/demo.css" rel="stylesheet" />

	<script src="/assets/js/vendors/jquery.js"></script>
	<script src="/assets/js/vendors/jquery-text.js"></script>
	<script src="/assets/js/funciones.js?v=20260921-reglas-toggle"></script>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body class="app sidebar-mini">
    <form id="frmMaster" runat="server" enctype="multipart/form-data">
		<asp:ScriptManager ID="smMaster" runat="server"></asp:ScriptManager>

        <!-- Loader -->
		<div id="global-loader">
			<img src="/assets/images/svgs/loader.svg" alt="loader" />
		</div>
        <!-- /Loader -->

        <!-- Page -->
        <div class="page">

            <!-- Main Header -->
