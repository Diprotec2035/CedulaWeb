<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<!-- REGLAS: a qué targets escribe y desde qué nivel -->
	<rules>
		<!-- Todo logger de la app, desde Info hacia arriba, va al archivo -->
		<logger name="*" minlevel="Info" writeTo="logfile" />
	</rules>
	<!-- TARGETS: dónde se escriben los logs -->
	<targets>
		<!-- Archivo: logs/{yyyy}/{MM}/api-dispositivos-YYYY-MM-DD.log -->
		<target xsi:type="File" name="logfile"
			fileName="${basedir}/logs/${date:format=yyyy}/${date:format=MM}/cedulaweb-${shortdate}.log"
			layout="${longdate}|${level}|${logger}|${message}|${exception:format=tostring}" />
	</targets>
</nlog>